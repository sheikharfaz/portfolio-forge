{
  "name": "minimal",
  "title": "Minimal",
  "description": "Typography-led, no WebGL. Builds in seconds and works on any device. The hardest template to make look bad.",
  "version": "1.0.0",
  "author": "Sheikh Arfaz Ahamed",
  "license": "MIT",
  "buildCommand": "npm run build",
  "outDir": "dist",
  "sections": ["hero", "about", "skills", "projects", "experience", "education", "contact", "footer"],
  "capabilities": {
    "webgl": false,
    "darkMode": true,
    "contactProviders": ["formspree", "mailto", "none"],
    "minNodeVersion": "20.11.0"
  },
  "constraints": {
    "identity.headline": { "maxLength": 52 },
    "identity.tagline": { "maxLength": 80 },
    "projects": { "maxItems": 8 },
    "skills": { "maxItems": 5 }
  },
  "budgets": {
    "maxBundleKb": 90,
    "minLighthousePerformance": 95,
    "minLighthouseAccessibility": 100
  }
}
