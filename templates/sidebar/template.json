{
  "name": "sidebar",
  "title": "Sidebar",
  "description": "Identity pinned to a fixed left column while the content scrolls beside it. Orientation never leaves the screen.",
  "version": "1.0.0",
  "author": "Sheikh Arfaz Ahamed",
  "license": "MIT",
  "buildCommand": "npm run build",
  "outDir": "dist",
  "sections": ["hero", "about", "experience", "projects", "skills", "education", "contact", "footer"],
  "capabilities": { "webgl": false, "darkMode": true, "contactProviders": ["formspree", "mailto", "none"], "minNodeVersion": "20.11.0" },
  "constraints": { "identity.headline": { "maxLength": 42 }, "identity.tagline": { "maxLength": 70 }, "projects": { "maxItems": 8 }, "skills": { "maxItems": 4 } },
  "budgets": { "maxBundleKb": 90, "minLighthousePerformance": 95, "minLighthouseAccessibility": 100 }
}
